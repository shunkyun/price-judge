# ===== 価格取得（公式API）=====
# 楽天ウェブサービス https://webservice.rakuten.co.jp/ （アプリID＋アクセスキー pk_... の2点が必要）
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
# 楽天アプリ登録時の「アプリケーションURL」と同じオリジン（必要な場合のみ）例 https://your-app.onrender.com
RAKUTEN_ORIGIN=
# Yahoo!デベロッパーネットワーク https://e.developer.yahoo.co.jp/ の Client ID
YAHOO_APP_ID=
# Keepa（有料・任意）Amazon の価格履歴
KEEPA_API_KEY=
# 専門店（楽天市場店・Yahoo!店）に絞った追加検索の店数（取得元ごと。既定2、0で無効、最大5）
# SHOP_SEARCH_MAX=2

# ===== AI（任意）画像からの商品特定・説明文。OpenAI 互換 API =====
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_VISION_MODEL=
# 検索語から不要語を「削除のみ」で整える（語の追加・言い換えは不採用）
LLM_NORMALIZE=0
# AI呼び出しの1日の上限回数（費用対策）
LLM_DAILY_LIMIT=100

# ===== 動作設定 =====
# auto=APIキーが無ければデモ / 1=常にデモ / 0=デモ無効
DEMO_MODE=auto
MIN_SAMPLES=10
MIN_SOURCES=2
MIN_SELLERS=3
OUTLIER_IQR_K=1.5
RELEVANCE_MIN=0.6
RECENT_DAYS=30
# DB_PATH=./data/prices.db

# ===== 公開時の保護 =====
# IP単位の上限（1分あたり）
RATE_ANALYZE_PER_MIN=10
RATE_IDENTIFY_PER_MIN=3
RATE_SUGGEST_PER_MIN=120
# 取得元APIへの最小間隔（秒）。楽天・Yahooは概ね1リクエスト/秒が目安
UPSTREAM_INTERVAL_SEC=1.0
# 公開時の簡易パスコード（空=誰でも利用可）。半角英数字で12文字以上を推奨。設定すると画面でコード入力を求める
ACCESS_CODE=
# 利用者IPの判定（共有回線・なりすまし対策）
# TRUSTED_PROXY_HEADER: 手前のプロキシが必ず上書きするヘッダ名。既定なし（ヘッダは信用しない）。
#   Render は CF-Connecting-IP（render.yaml で設定済み）。Cloudflare を通らない環境では設定しないこと
# TRUSTED_PROXY_CIDRS: 設定すると、接続元がこの範囲のときだけ上記ヘッダ・X-Forwarded-For を使う
# TRUST_PROXY: X-Forwarded-For の「右から何段目」を利用者IPとみなすか（0=使わない）。左端は偽装できるため使いません
TRUSTED_PROXY_HEADER=
TRUSTED_PROXY_CIDRS=
TRUST_PROXY=0
# アクセスコード認証済みのとき、IP単位（庁舎などの共有回線）の上限。端末ごとの上限は RATE_ANALYZE_PER_MIN
RATE_IP_AUTHED_PER_MIN=60
# アクセスコードの誤り許容回数（10分あたり・IP単位）。超えると10分間拒否
ACCESS_CODE_MAX_FAILURES=10
# 回線（IP）単位の誤り上限（10分あたり）。ロック中も、すでに利用中の人（利用券あり）は止まらない
ACCESS_CODE_IP_MAX_FAILURES=50
# 1回線から1時間に開始できる利用数・利用券の有効時間
MAX_SESSIONS_PER_IP=30
SESSION_HOURS=12
# 利用券の署名鍵（空なら起動ごとに自動生成）
# SESSION_SECRET=
# 画面に「管理者向けの注意」を出す合言葉（?admin=値）。自分のPCで開いたときは常に表示
# ADMIN_TOKEN=
# 取得元が混雑しているとき、待ち時間がこの秒数を超えるなら「混雑中」と返す
MAX_QUEUE_WAIT_SEC=20
# 価格推移グラフで1日分の点として表示するのに必要な件数
TREND_MIN_POINT_N=3
# 推移用識別子のハッシュ化に使う秘密値（空なら初回起動時に自動生成してDBに保存）
# HASH_SALT=
# 価格データの保存期間（日）
DB_RETENTION_DAYS=400
# ローカル起動の待ち受け（既定 127.0.0.1。LANに公開する場合のみ 0.0.0.0）
# HOST=127.0.0.1
